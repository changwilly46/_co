|RAM[256]|RAM[300]|RAM[401]|RAM[402]|RAM[3006|RAM[3012|RAM[3015|RAM[11] |
|    472 |     10 |     21 |     22 |     36 |     42 |     45 |    510 |
import sys
import os


class VMTranslator:
    def __init__(self, filename):
        self.filename = os.path.splitext(os.path.basename(filename))[0]
        self.label_count = 0
        self.seg_map = {
            "local": "LCL",
            "argument": "ARG",
            "this": "THIS",
            "that": "THAT",
        }

    def _push_d(self):
        return ["@SP", "A=M", "M=D", "@SP", "M=M+1"]

    def translate_line(self, line):
        line = line.split("//")[0].strip()
        if not line:
            return []

        parts = line.split()
        cmd = parts[0]
        asm = [f"// {line}"]

        if cmd == "push":
            seg, idx = parts[1], int(parts[2])
            if seg == "constant":
                asm += [f"@{idx}", "D=A"] + self._push_d()
            elif seg in self.seg_map:
                asm += [f"@{self.seg_map[seg]}", "D=M", f"@{idx}", "A=D+A", "D=M"] + self._push_d()
            elif seg == "temp":
                asm += [f"@{5 + idx}", "D=M"] + self._push_d()
            elif seg == "pointer":
                base = "THIS" if idx == 0 else "THAT"
                asm += [f"@{base}", "D=M"] + self._push_d()
            elif seg == "static":
                asm += [f"@{self.filename}.{idx}", "D=M"] + self._push_d()

        elif cmd == "pop":
            seg, idx = parts[1], int(parts[2])
            if seg in self.seg_map:
                asm += [
                    f"@{self.seg_map[seg]}", "D=M", f"@{idx}", "D=D+A",
                    "@R13", "M=D",
                    "@SP", "AM=M-1", "D=M",
                    "@R13", "A=M", "M=D",
                ]
            elif seg == "temp":
                asm += ["@SP", "AM=M-1", "D=M", f"@{5 + idx}", "M=D"]
            elif seg == "pointer":
                base = "THIS" if idx == 0 else "THAT"
                asm += ["@SP", "AM=M-1", "D=M", f"@{base}", "M=D"]
            elif seg == "static":
                asm += ["@SP", "AM=M-1", "D=M", f"@{self.filename}.{idx}", "M=D"]

        elif cmd == "add":
            asm += ["@SP", "AM=M-1", "D=M", "A=A-1", "M=M+D"]
        elif cmd == "sub":
            asm += ["@SP", "AM=M-1", "D=M", "A=A-1", "M=M-D"]
        elif cmd == "neg":
            asm += ["@SP", "A=M-1", "M=-M"]
        elif cmd == "and":
            asm += ["@SP", "AM=M-1", "D=M", "A=A-1", "M=M&D"]
        elif cmd == "or":
            asm += ["@SP", "AM=M-1", "D=M", "A=A-1", "M=M|D"]
        elif cmd == "not":
            asm += ["@SP", "A=M-1", "M=!M"]
        elif cmd in ("eq", "gt", "lt"):
            jmp = {"eq": "JEQ", "gt": "JGT", "lt": "JLT"}[cmd]
            t_lbl = f"TRUE_{self.label_count}"
            e_lbl = f"END_{self.label_count}"
            self.label_count += 1
            asm += [
                "@SP", "AM=M-1", "D=M", "A=A-1", "D=M-D",
                f"@{t_lbl}", f"D;{jmp}",
                "@SP", "A=M-1", "M=0",
                f"@{e_lbl}", "0;JMP",
                f"({t_lbl})",
                "@SP", "A=M-1", "M=-1",
                f"({e_lbl})",
            ]

        return asm

    def translate_file(self, input_path):
        output_path = os.path.splitext(input_path)[0] + ".asm"
        output_lines = []
        with open(input_path, "r", encoding="utf-8") as f:
            for line in f:
                output_lines.extend(self.translate_line(line))

        with open(output_path, "w", encoding="utf-8") as f:
            f.write("\n".join(output_lines) + "\n")
        print(f"已產生: {output_path}")


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("用法: python VMTranslator.py BasicTest.vm")
        sys.exit(1)
    vm_file = sys.argv[1]
    VMTranslator(vm_file).translate_file(vm_file)