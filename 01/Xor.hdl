// File name: projects/01/Xor.hdl

/**
 * Exclusive-or gate:
 * out = not (a == b)
 */

CHIP Xor {
    IN a, b;
    OUT out;

    PARTS:
    // Put your code here:
    Not(in=a, out=notA);
    Not(in=b, out=notB);
    
    // (a AND NOT b)
    And(a=a, b=notB, out=w1);
    
    // (NOT a AND b)
    And(a=notA, b=b, out=w2);
    
    // (a AND NOT b) OR (NOT a AND b)
    Or(a=w1, b=w2, out=out);
}